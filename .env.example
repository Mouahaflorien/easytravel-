# ==============================================================================
# CONFIGURATION ENVIRONNEMENT EASYTRAVEL (EXEMPLE)
# Copiez ce fichier en '.env' et configurez vos vraies valeurs secrètes.
# ==============================================================================

# 1. Clé secrète Django (OBLIGATOIRE EN PRODUCTION)
DJANGO_SECRET_KEY=change-me-to-a-very-long-and-cryptographic-secret-key-in-prod

# 2. Mode Débogage (True en local, TOUJOURS False en production)
DJANGO_DEBUG=True

# 3. Noms d'hôtes autorisés (séparés par des virgules)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,easytravel.cm,www.easytravel.cm

# 4. Domaines CSRF de confiance pour les formulaires en ligne (HTTPS)
CSRF_TRUSTED_ORIGINS=https://easytravel.cm,https://www.easytravel.cm

# 5. Base de données (vide = SQLite local, sinon PostgreSQL en production)
# Format PostgreSQL : postgres://UTILISATEUR:MOTDEPASSE@HOTE:PORT/NOM_BASE
DATABASE_URL=

# 6. Clé API Google Gemini (Pour la Sentinelle d'Audit IA des fraudes)
GEMINI_API_KEY=

# 7. Opérateur de Paiement CinetPay (Mobile Money MTN, Orange Money, Visa/Mastercard)
CINETPAY_SITE_ID=
CINETPAY_API_KEY=
CINETPAY_CURRENCY=XAF
CINETPAY_RETURN_URL=https://easytravel.cm/paiements/cinetpay/retour/
CINETPAY_NOTIFY_URL=https://easytravel.cm/paiements/cinetpay/notification/

# 8. Opérateur de Paiement Campay (MTN MoMo, Orange Money Cameroun Direct)
CAMPAY_APP_USERNAME=
CAMPAY_APP_PASSWORD=
CAMPAY_ENVIRONMENT=sandbox

# 9. Service d'envoi d'Emails (Console en local, SMTP / SendGrid / Postmark en prod)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
